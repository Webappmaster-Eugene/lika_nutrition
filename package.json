{
  "name": "lika-nutrition",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run lint && npm run typecheck && npm run build",
    "convert-docx": "tsx scripts/convert-docx.ts",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:test": "./test-docker.sh",
    "codex": "node scripts/codex/harness.mjs launch",
    "codex:setup": "node scripts/codex/setup.mjs",
    "codex:sync": "node scripts/codex/harness.mjs sync",
    "codex:doctor": "node scripts/codex/harness.mjs doctor",
    "codex:verify": "node scripts/codex/harness.mjs verify",
    "codex:test": "node --test scripts/codex/harness.test.mjs",
    "codex:mcp-check": "node scripts/codex/mcp.mjs probe",
    "codex:browser-check": "node scripts/codex/mcp.mjs browser-check",
    "codex:native-check": "node scripts/codex/native-check.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.29.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.344.0",
    "mammoth": "^1.6.0",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
